# Copy to .env and fill in. NEVER commit .env.
# Optional: LLM for the Report Writer narrative (any LiteLLM/CrewAI model string)
LLM_API_KEY=
LLM_MODEL=gemini/gemini-2.0-flash
# Optional: NewsAPI.org key for extra news (yfinance news is used without a key)
NEWSAPI_KEY=
REQUEST_TIMEOUT=15
MAX_RETRIES=3
CACHE_TTL_SECONDS=900
